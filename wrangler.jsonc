// Cloudflare Workers static assets (PLAN D-12 as amended in §2.5). Workers Builds
// runs `npm run build` then `npx wrangler deploy` with this file; without it every
// build re-runs wrangler's autoconfig, which rewrites vite.config.ts in the build
// sandbox. There is no Worker script: `dist/` is served as-is and `public/_headers`
// (copied into `dist/` by Vite) supplies the PLAN §11 headers.
{
  "name": "in-your-sky",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    // Hash routing (D-13): unknown paths are real 404s, not index.html.
    "not_found_handling": "404-page"
  },
  // D-658 (FR-ADDR-2): the public address is a custom domain bound by `wrangler
  // deploy`, which creates the DNS record and the certificate in the zone the
  // account holds; nothing is set in the dashboard. `workers_dev` stays so the
  // old address serves the same build (FR-ADDR-3), `preview_urls` stays because a
  // custom domain has no preview form: branch previews keep their per-branch URL.
  "routes": [{ "pattern": "inyoursky.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // FR-X-3: no analytics; an assets-only Worker has nothing to log anyway.
  "observability": { "enabled": false }
}
