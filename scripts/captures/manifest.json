    "live-scrubbing": {"route": "live", "extras": []},
    "live-tonight": {"route": "live", "extras": []},
    "live-sheet": {"route": "live", "extras": []},
    "live-sheet-list": {"route": "live", "extras": []},
    "live-following": {"route": "live", "extras": []},
    "stars": {"route": "stars", "extras": []},
