{
  "$comment": "PLAN D-1068 (FR-SDD-22): the source globs each capture draws. `all` is what every capture of the set draws \u2014 the shell, the styles, the catalogs, the state and the physics, the build's inputs and the capture run itself \u2014 and `screens` maps each screen name in tests/e2e/captureSet.ts to what that screen adds. A unit test or a snapshot under src/ draws nothing. `node scripts/ci-affected.ts --captures <base>` picks the screens a diff reaches. Each screen names its `route` (a shared glob list under `routes`) and its own `extras`.",
  "all": [
    "index.html",
    "public/**",
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/ui/*.{ts,tsx,css}",
    "src/ui/styles/**",
    "src/ui/hooks/**",
    "src/ui/components/{common,primitives,mark}/**",
    "src/ui/screens/home/shownPasses.ts",
    "src/ui/screens/home/placeRequest.ts",
    "src/i18n/**",
    "src/state/**",
    "src/model/**",
    "src/lib/**",
    "src/physics/**",
    "src/worker/**",
    "src/data/**",
    "vite.config.ts",
    "playwright.config.ts",
    "package-lock.json",
    "tests/fixtures/**",
    "tests/e2e/{v1-captures.spec,captureSet,captureFirst,captureSeeds,liveHelpers,observers,orientation}.ts",
    "scripts/captures/{compress.ts,manifest.json}",
    "tests/e2e/promoFlows.ts",
    "src/ui/screens/{whenIdle,settingsChunk}.ts"
  ],
  "routes": {
    "settings": ["src/ui/screens/{Settings.tsx,Settings.module.css,SettingsRoute.tsx,settingsChunk.ts}", "src/ui/components/location/**"],
    "detail": ["src/ui/screens/{PassDetail.tsx,PassDetail.module.css,passSelection.ts,chartViewDefault.ts}", "src/ui/screens/sky/{pass/**,sky.module.css}", "src/ui/screens/home/**", "src/ui/components/{guide,sky,moon,weather,live,now,passes,elements}/**"],
    "live": ["src/ui/screens/{Live.tsx,Live.module.css,LiveRoute.ts,liveRows.ts,chartViewDefault.ts}", "src/ui/screens/sky/{live/**,sky.module.css}", "src/ui/screens/home/placeRequest.ts", "src/ui/components/{live,sky,guide,passes,moon,weather,location}/**"]
  },
  "screens": {
    "first-pass": {"route": "detail", "extras": []},
    "first-live": {"route": "live", "extras": []},
    "settings": {"route": "settings", "extras": []},
    "guide": {"route": "detail", "extras": []},
    "polar": {"route": "detail", "extras": []},
    "legend": {"route": "live", "extras": []},
    "favourites": {"route": "settings", "extras": []},
    "shortcuts": {"route": "detail", "extras": []},
    "live-watching": {"route": "live", "extras": []},
    "live-scrubbing": {"route": "live", "extras": []},
    "live-tonight": {"route": "live", "extras": []},
    "live-sheet": {"route": "live", "extras": []},
    "live-sheet-list": {"route": "live", "extras": []},
    "live-following": {"route": "live", "extras": []},
    "sky-live-globe": {"route": "live", "extras": []},
    "sky-pass-globe": {"route": "detail", "extras": []},
    "sky-clouds": {"route": "live", "extras": []},
    "sky-pass-facts": {"route": "detail", "extras": []},
    "sky-live-facts": {"route": "live", "extras": []},
    "sky-hover": {"route": "live", "extras": []},
    "sky-fullscreen": {"route": "live", "extras": ["src/lib/fullscreen.ts"]},
    "guide-sheet": {"route": "detail", "extras": []},
    "live-window": {"route": "live", "extras": []},
    "live-window-follow": {"route": "live", "extras": []},
    "guide-window": {"route": "detail", "extras": []},
    "guide-short": {"route": "detail", "extras": []},
    "live-twilight": {"route": "live", "extras": []}
  }
}
